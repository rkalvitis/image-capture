+# Every _name:=value the script understands (record + run mode). Used
+# only to catch flags that would otherwise be silently ignored.
+KNOWN_PARAMS = (
+    "confirm_each_pose", "confirm_port", "confirm_via", "execute",
+    "holder_mesh", "holder_yaw_deg", "holder_z_offset", "joint_file",
+    "keepout_ignored_links", "lens_axis", "lens_xyz", "mode",
+    "object_distance", "object_height", "object_radius", "object_xyz",
+    "obstacles", "output_file", "planning_time", "poses_file",
