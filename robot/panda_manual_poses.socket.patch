+def check_cli_params():
+    """
+    Warns about command-line flags that get_param_once would never
+    see: `confirm_each_pose:=true` (no leading underscore = a ROS
+    topic remap, NOT a parameter), typos in the name, or a value
+    split off by a space (`_confirm_each_pose:= true`). Returns the
+    number of bad flags. Logged, not fatal, so a genuine remap still
+    works.
+    """
+
+    bad = 0
+    seen = []
+
+    for argument in sys.argv[1:]:
+        if argument.startswith("__"):
+            continue  # __name:=, __log:= ... added by rosrun/roslaunch
+
+        if ":=" not in argument:
+            if argument.startswith("_") or argument in KNOWN_PARAMS:
+                rospy.logwarn(
+                    "Ignored argument %r - a parameter is written "
+                    "_name:=value (no spaces).", argument)
+                bad += 1
+            continue
+
+        name, value = argument.split(":=", 1)
+
+        if not name.startswith("_"):
+            if name in KNOWN_PARAMS:
+                rospy.logwarn(
+                    "IGNORED: %r has no leading underscore, so ROS "
+                    "treats it as a topic remap. Use _%s", argument,
+                    argument)
+                bad += 1
+            continue
+
+        key = name.lstrip("_")
+        if key not in KNOWN_PARAMS:
+            rospy.logwarn(
+                "IGNORED: unknown parameter %r (known: %s)", argument,
+                ", ".join("_" + k for k in KNOWN_PARAMS))
+            bad += 1
+            continue
+
+        if value == "":
+            rospy.logwarn(
+                "%r has an empty value - if you meant a value, write "
+                "it without a space: %s:=value", argument, name)
+
+        seen.append("%s=%r" % (key, _parse_cli_value(value)))
+
+    if seen:
+        rospy.loginfo("Command-line parameters: %s", ", ".join(seen))
+    else:
+        rospy.loginfo("Command-line parameters: none (all defaults)")
+
+    return bad
+
+
+def _have_terminal():
+    """
+    True when Enter can be read: stdin is a tty or /dev/tty opens.
+    Uses arc.have_terminal when the arc module on this PC has it,
+    so this file can still be copied on its own next to an older
+    panda_semicircle_motion.py.
+    """
+
+    if hasattr(arc, "have_terminal"):
+        return arc.have_terminal()
+
+    try:
+        if sys.stdin is not None and sys.stdin.isatty():
+            return True
+    except (ValueError, AttributeError):
+        pass
+
+    try:
+        open("/dev/tty", "r").close()
+        return True
+    except (IOError, OSError):
+        return False
+
+
+def _parse_joint_rows(file_path):
+    """
+    Rows of 7 joint values from a text file, whatever the layout:
+      - separators: comma, semicolon, tab or spaces; quotes/brackets ignored
+      - plain rows  j1 .. j7
+      - the quoted form  "j1, .., j7",x,y,z,...   (first 7 numbers = joints)
+      - a header line naming the columns (joint1 .. joint7 are then taken
+        by NAME, so extra columns such as waypoint/angle/position are safe)
+    Blank lines are skipped. Python 2 and 3.
+    """
+    import re
+    joint_cols = None
+    rows = []
+    with open(file_path, "r") as handle:
+        for raw in handle:
+            line = raw.strip()
+            if not line:
+                continue
+            cleaned = re.sub(r'[\[\]"\']', " ", line)
+            tokens = [t for t in re.split(r"[,;\t ]+", cleaned) if t]
+            if re.search(r"[A-Za-z]", cleaned):
+                # header: remember where joint1..joint7 are
+                names = [t.strip().lower() for t in tokens]
+                idx = []
+                for j in range(1, 8):
+                    for cand in ("joint%d" % j, "joint_%d" % j, "j%d" % j, "q%d" % j):
+                        if cand in names:
+                            idx.append(names.index(cand))
+                            break
+                joint_cols = idx if len(idx) == 7 else None
+                continue
+            try:
+                nums = [float(t) for t in tokens]
+            except ValueError:
+                raise ValueError(
+                    "Non-numeric row in {}: {!r}".format(file_path, line))
+            if joint_cols is not None and len(nums) > max(joint_cols):
+                rows.append([nums[i] for i in joint_cols])
+            elif len(nums) >= 7:
+                rows.append(nums[:7])
+            else:
+                raise ValueError(
+                    "Row with fewer than 7 joint values in {}: {!r}".format(
+                        file_path, line))
+    return rows
+
